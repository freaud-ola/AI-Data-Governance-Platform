APP_NAME="AI Data Governance Platform"
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEFAULT_TENANT_ID=default

# 数据存储：USE_MOCK=true（默认）走内存；USE_MOCK=false 且配置 DATABASE_URL 走 PostgreSQL
USE_MOCK=true
# USE_MOCK=false
# DATABASE_URL=postgresql+psycopg://adg:adg_dev_pwd@localhost:5432/adg
# REDIS_URL=redis://localhost:6379/0
