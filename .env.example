# ============================================================================
# AI Data Governance Platform · 顶层环境变量（供 docker-compose 使用）
#
# 用法: 复制为 .env 后按需修改
#   cp .env.example .env
#   docker compose up -d
# ============================================================================

# ---- 端口（宿主机暴露） ----
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- 后端（docker-compose：backend 服务内已固定 USE_MOCK=false + DATABASE_URL；此处可调 APP_* / DEFAULT_TENANT_ID）----
APP_ENV=dev
APP_DEBUG=true
DEFAULT_TENANT_ID=default

# ---- PostgreSQL ----
POSTGRES_DB=adg
POSTGRES_USER=adg
POSTGRES_PASSWORD=adg_dev_pwd

# ---- 镜像仓库（国内/受限网络配置） ----
# 默认走 docker.io。如果 build 时 `python:3.11-slim` / `node:22-alpine` / `nginx:1.27-alpine`
# 拉取超时，把这里改成可达的 docker.io 镜像源即可。常见 mirror：
#   IMAGE_REGISTRY=docker.m.daocloud.io/library
#   IMAGE_REGISTRY=docker.1panel.live/library
#   IMAGE_REGISTRY=dockerproxy.com/library
# 注意：必须以 `/library` 结尾（对应 docker.io/library/ 命名空间）
IMAGE_REGISTRY=docker.io/library

# ---- pip（仅 docker build backend 时使用）----
# 默认清华 TUNA PyPI（文档：https://mirrors.tuna.tsinghua.edu.cn/help/pypi/ ）。
# 海外网络可直接改用官方：PIP_INDEX_URL=https://pypi.org/simple
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

# ---- 可选：Hive + 数据平台 MySQL（compose profile）----
# 取消下一行注释后，`docker compose up -d` 会一并启动 mysql-platform、hive-dev。
# COMPOSE_PROFILES=datasources
MYSQL_PLATFORM_PORT=3307
MYSQL_PLATFORM_DATABASE=adg_platform
MYSQL_PLATFORM_USER=adg_app
MYSQL_PLATFORM_PASSWORD=adg_mysql_pwd
MYSQL_PLATFORM_ROOT_PASSWORD=adg_mysql_root
HIVE_METASTORE_PORT=9083
HIVE_DEV_PORT=10000
HIVE_DEV_WEBUI_PORT=10002
# Hive 镜像（须版本匹配）：默认 Metastore 4.2 + HS2 4.2
# HIVE_METASTORE_IMAGE=apache/hive:standalone-metastore-4.2.0
# HIVE_HS2_IMAGE=apache/hive:4.2.0
